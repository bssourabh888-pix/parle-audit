    function handleMultipleWorkingPapers(event) {
      if (!isCurrentSlotBooked) {
        alert("Please claim an auditor slot first.");
        return;
      }
      const files = Array.from(event.target.files);
      if (!files || files.length === 0) return;

      let readCounter = 0;
      files.forEach(f => {
        if (!workingPaperAttachments.some(existing => existing.name === f.name)) {
          const reader = new FileReader();
          reader.onload = function(e) {
            workingPaperAttachments.push({
              name: f.name,
              size: formatBytes(f.size),
              uploadedAt: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
              base64: e.target.result
            });
            readCounter++;
            if (readCounter === files.length) {
              renderWorkingPaperList();
              saveAuditProgress(true);
            }
          };
          reader.readAsDataURL(f);
        }
      });
      event.target.value = '';
    }

    function removeWorkingPaper(index) {
