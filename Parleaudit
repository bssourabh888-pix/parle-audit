          <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
            <i class="ph-bold ph-google-chrome-logo text-emerald-600"></i>
            Google Sheets & Drive Script (Apps Script)
          </h3>
          <p class="text-xs text-slate-500">Auto-saves and deletes revoked folders/rows from Google Drive and Sheets.</p>
        </div>
        <button onclick="closeAppsScriptModal()" class="w-8 h-8 rounded-lg hover:bg-slate-100 text-slate-400 hover:text-slate-600 flex items-center justify-center">
          <i class="ph-bold ph-x text-lg"></i>
        </button>
      </div>

      <div class="relative">
        <textarea id="appsScriptCodeBlock" readonly rows="12" class="w-full bg-slate-900 text-emerald-400 font-mono text-[11px] p-4 rounded-xl focus:outline-none resize-none leading-relaxed select-all">function doGet(e) {
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Audits");
  if (!sheet) {
    sheet = SpreadsheetApp.getActiveSpreadsheet().insertSheet("Audits");
    sheet.appendRow(["Audit_ID", "Depot_Code", "Slot_Number", "Auditor_Name", "Auditor_Phone", "Status", "Man_Days", "Drive_Folder_URL", "Attendance_Drive_Links", "Working_Papers_Links", "ZSD_File_URL", "Excel_File_URL", "Scrap_Status", "Scrap_File_URL", "Remarks", "Last_Updated"]);
  }
  var rows = sheet.getDataRange().getValues();
  var audits = [];
  
  for (var i = 1; i < rows.length; i++) {
    var r = rows[i];
    if (!r[0]) continue;
    audits.push({
      id: String(r[0]),
      depotCode: String(r[1]),
      slotNumber: Number(r[2] || 1),
      auditorName: String(r[3]),
      auditorPhone: String(r[4]),
      status: String(r[5]),
      manDays: Number(r[6] || 0),
      driveFolderUrl: String(r[7] || ""),
      attendance: r[8] ? String(r[8]).split("\n") : [],
      workingPapers: r[9] ? String(r[9]).split("\n") : [],
      files: {
        zsdDump: String(r[10] || ""),
        reconciledExcel: String(r[11] || "")
      },
      scrapInvoiceAvailable: String(r[12] || ""),
      scrapInvoiceUrl: String(r[13] || ""),
      remarks: String(r[14] || ""),
      lastUpdated: String(r[15] || "")
    });
  }
  
  return ContentService.createTextOutput(JSON.stringify(audits))
    .setMimeType(ContentService.MimeType.JSON);
}

function doPost(e) {
  try {
    var data = JSON.parse(e.postData.contents);
    var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Audits");
    if (!sheet) {
      sheet = SpreadsheetApp.getActiveSpreadsheet().insertSheet("Audits");
      sheet.appendRow(["Audit_ID", "Depot_Code", "Slot_Number", "Auditor_Name", "Auditor_Phone", "Status", "Man_Days", "Drive_Folder_URL", "Attendance_Drive_Links", "Working_Papers_Links", "ZSD_File_URL", "Excel_File_URL", "Scrap_Status", "Scrap_File_URL", "Remarks", "Last_Updated"]);
    }

    var rootFolders = DriveApp.getFoldersByName("Parle_Stock_Audits");
    var rootFolder = rootFolders.hasNext() ? rootFolders.next() : DriveApp.createFolder("Parle_Stock_Audits");
    var depotFolderName = "Depot_" + data.depotCode + "_Slot_" + (data.slotNumber || 1);

    if (data.status === "Revoked") {
      var targetFolders = rootFolder.getFoldersByName(depotFolderName);
      while (targetFolders.hasNext()) {
        var folderToTrash = targetFolders.next();
        folderToTrash.setTrashed(true);
      }

      var rows = sheet.getDataRange().getValues();
      for (var i = rows.length - 1; i >= 1; i--) {
        if (String(rows[i][0]) === String(data.id)) {
          sheet.deleteRow(i + 1);
          break;
        }
      }

      return ContentService.createTextOutput(JSON.stringify({
        status: "success",
        message: "Record and folder deleted successfully for " + data.id
      })).setMimeType(ContentService.MimeType.JSON);
    }

    var subFolders = rootFolder.getFoldersByName(depotFolderName);
    var auditFolder = subFolders.hasNext() ? subFolders.next() : rootFolder.createFolder(depotFolderName);

    function saveBase64File(folder, base64DataString, fileName) {
      if (!base64DataString || !base64DataString.includes(",")) return "";
      var parts = base64DataString.split(",");
      var contentType = parts[0].split(":")[1].split(";")[0];
      var decoded = Utilities.base64Decode(parts[1]);
      var blob = Utilities.newBlob(decoded, contentType, fileName);
      var file = folder.createFile(blob);
      file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
      return file.getUrl();
    }

    var attendanceLinks = [];
    if (data.attendance && data.attendance.length > 0) {
      var attFolder = auditFolder.getFoldersByName("Attendance");
      var attTarget = attFolder.hasNext() ? attFolder.next() : auditFolder.createFolder("Attendance");

      data.attendance.forEach(function(day) {
        var dayNum = day.day || 1;
        if (day.checkin && day.checkin.photo && day.checkin.photo.startsWith("data:")) {
          var inName = "Day_" + dayNum + "_Checkin_" + String(day.checkin.time || "").replace(/[: ]/g, "_") + ".jpg";
          day.checkin.driveUrl = saveBase64File(attTarget, day.checkin.photo, inName);
        }
        if (day.checkout && day.checkout.photo && day.checkout.photo.startsWith("data:")) {
          var outName = "Day_" + dayNum + "_Checkout_" + String(day.checkout.time || "").replace(/[: ]/g, "_") + ".jpg";
          day.checkout.driveUrl = saveBase64File(attTarget, day.checkout.photo, outName);
        }
        attendanceLinks.push("Day " + dayNum + " (In: " + (day.checkin ? day.checkin.driveUrl : "N/A") + " | Out: " + (day.checkout ? day.checkout.driveUrl : "N/A") + ")");
      });
    }

    var wpDriveLinks = [];
    if (data.workingPapers && data.workingPapers.length > 0) {
      var wpFolder = auditFolder.getFoldersByName("Working_Papers");
      var wpTarget = wpFolder.hasNext() ? wpFolder.next() : auditFolder.createFolder("Working_Papers");

      data.workingPapers.forEach(function(wp) {
        if (wp.base64) {
          var wpUrl = saveBase64File(wpTarget, wp.base64, wp.name);
          wpDriveLinks.push(wp.name + " (" + wpUrl + ")");
        }
      });
    }

    var docsFolder = auditFolder.getFoldersByName("Deliverables");
    var docsTarget = docsFolder.hasNext() ? docsFolder.next() : auditFolder.createFolder("Deliverables");

    var zsdUrl = "";
    if (data.files && data.files.zsdDataBase64) {
      zsdUrl = saveBase64File(docsTarget, data.files.zsdDataBase64, data.files.zsdDump || "ZSD_Dump.xlsx");
    }

    var excelUrl = "";
    if (data.files && data.files.excelDataBase64) {
      excelUrl = saveBase64File(docsTarget, data.files.excelDataBase64, data.files.reconciledExcel || "Reconciled_Stock.xlsx");
    }

    var scrapUrl = "";
    if (data.scrapInvoicePhoto && data.scrapInvoicePhoto.startsWith("data:")) {
      scrapUrl = saveBase64File(docsTarget, data.scrapInvoicePhoto, data.scrapInvoiceFileName || "Scrap_Invoice.jpg");
    }

    var rows = sheet.getDataRange().getValues();
    var rowIndex = -1;
    for (var i = 1; i < rows.length; i++) {
      if (String(rows[i][0]) === String(data.id)) {
        rowIndex = i + 1;
        break;
      }
    }

    var rowData = [
      String(data.id),
      String(data.depotCode),
      data.slotNumber || 1,
      data.auditorName || "",
      String(data.auditorPhone || ""),
      data.status || "In Progress",
      data.attendance ? data.attendance.length : 0,
      auditFolder.getUrl(),
      attendanceLinks.join("\n"),
      wpDriveLinks.join("\n"),
      zsdUrl,
      excelUrl,
      data.scrapInvoiceAvailable || "No",
      scrapUrl,
      data.remarks || "",
      new Date().toLocaleString()
    ];

    if (rowIndex > 0) {
      sheet.getRange(rowIndex, 1, 1, rowData.length).setValues([rowData]);
    } else {
      sheet.appendRow(rowData);
    }

    return ContentService.createTextOutput(JSON.stringify({ 
      status: "success", 
      folderUrl: auditFolder.getUrl(),
      id: data.id 
    })).setMimeType(ContentService.MimeType.JSON);

  } catch (err) {
    return ContentService.createTextOutput(JSON.stringify({ status: "error", message: err.toString() }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}</textarea>
