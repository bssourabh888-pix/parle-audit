    function processNativeSelfie(event, type) {
      const file = event.target.files[0];
      if (!file) return;

      if (!latestGPS || !latestGPS.lat || !latestGPS.lng) {
        alert("Accurate GPS location not locked yet. Please tap 'Retry' on the GPS indicator and allow your phone to locate you before taking the photo.");
        event.target.value = '';
        return;
      }

      const depotCode = activeDepotCode;
      const auditorName = document.getElementById('inputAuditorName').value || 'Auditor';
      const now = new Date();
      const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      const dateStr = now.toLocaleDateString('en-IN');
      const lat = latestGPS.lat;
      const lng = latestGPS.lng;

      const reader = new FileReader();
      reader.onload = function(e) {
        const img = new Image();
        img.onload = function() {
          const canvas = document.getElementById('watermarkCanvas');
          const ctx = canvas.getContext('2d');

          canvas.width = 800;
          canvas.height = 1066;

          ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

          ctx.fillStyle = "rgba(15, 23, 42, 0.85)";
          ctx.fillRect(0, canvas.height - 140, canvas.width, 140);

          ctx.fillStyle = "#f59e0b";
          ctx.font = "bold 26px sans-serif";
          ctx.fillText(`PARLE STOCK AUDIT • ${type.toUpperCase()} SELFIE`, 24, canvas.height - 95);

          ctx.fillStyle = "#ffffff";
          ctx.font = "20px sans-serif";
          ctx.fillText(`Auditor GPS: ${lat}, ${lng} (±${latestGPS.accuracy}m)  |  ${dateStr} ${timeStr}`, 24, canvas.height - 60);
          ctx.fillText(`Depot: ${depotCode} (Slot ${currentSlotNumber})  |  Auditor: ${auditorName}`, 24, canvas.height - 25);

          const watermarkedPhotoData = canvas.toDataURL('image/jpeg', 0.85);

          tempAttendanceEntry[type] = {
            time: timeStr,
            date: dateStr,
            lat: lat,
            lng: lng,
            photo: watermarkedPhotoData
          };

          if (type === 'checkin') {
            document.getElementById('statusCheckinDone').textContent = `Done (${timeStr})`;
            document.getElementById('previewCheckinBox').classList.remove('hidden');
            document.getElementById('imgCheckinThumb').src = watermarkedPhotoData;
            document.getElementById('timeCheckinText').textContent = `Arrival: ${timeStr}`;
            document.getElementById('coordsCheckinText').textContent = `${lat}, ${lng}`;
            document.getElementById('statusCheckoutDone').textContent = "Ready for Departure Selfie";
          } else {
            document.getElementById('statusCheckoutDone').textContent = `Done (${timeStr})`;
            document.getElementById('previewCheckoutBox').classList.remove('hidden');
            document.getElementById('imgCheckoutThumb').src = watermarkedPhotoData;
            document.getElementById('timeCheckoutText').textContent = `Departure: ${timeStr}`;
            document.getElementById('coordsCheckoutText').textContent = `${lat}, ${lng}`;
          }
          saveAuditProgress(true);
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    }

    function commitDailyAttendance() {
      if (!tempAttendanceEntry.checkin) {
        alert("Arrival Check-In selfie is required.");
        return;
      }

      saveAuditProgress(true);

      const audit = auditRecords.find(a => a.id === currentAuditId);
      if (audit) {
        if (!audit.attendance) audit.attendance = [];

        if (editingAttendanceDayIndex >= 0 && audit.attendance[editingAttendanceDayIndex]) {
          audit.attendance[editingAttendanceDayIndex].checkout = tempAttendanceEntry.checkout || audit.attendance[editingAttendanceDayIndex].checkout;
          alert("Departure Check-Out saved successfully!");
