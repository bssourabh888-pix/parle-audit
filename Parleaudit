      MASTER_DEPOTS.forEach(d => {
        [1, 2].forEach(slotNum => {
          const slotKey = `AUDIT-${d.code}-SLOT${slotNum}`;
          const a = auditRecords.find(audit => audit.id === slotKey) || {};
          const status = a.status || "Scheduled";
          const manDays = a.attendance ? a.attendance.length : 0;
          const remarks = (a.remarks || "").replace(/"/g, '""');
          const scrapAvailable = a.scrapInvoiceAvailable || "Unanswered";
          const wpCount = a.workingPapers ? a.workingPapers.length : 0;
          const folderUrl = a.driveFolderUrl || "";

          csv += `"${slotKey}","${d.code}",${slotNum},"${d.userId || ''}","${d.name || ''}","${d.location || ''}","${d.state || ''}","${status}","${a.auditorName || ''}","${a.auditorPhone || ''}","${folderUrl}","${scrapAvailable}",${manDays},${wpCount},"${remarks}","${a.lastUpdated || ''}"\n`;
        });
      });

      const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
      const link = document.createElement("a");
      link.href = URL.createObjectURL(blob);
      link.download = `Parle_Audit_Master_${new Date().toISOString().slice(0, 10)}.csv`;
      link.click();
    }
  </script>
</body>
</html>
