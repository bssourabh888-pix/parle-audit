    // ATTENDANCE REGISTRATION - ACCURATE AUDITOR GPS
    function acquireLiveGPS() {
      const statusText = document.getElementById('gpsStatusText');
      const indicator = document.getElementById('gpsIndicator');

      if (!statusText || !indicator) return;

      statusText.textContent = "Acquiring accurate live GPS from device...";
      indicator.className = "w-2.5 h-2.5 rounded-full bg-amber-500 animate-pulse flex-shrink-0";

      if (!navigator.geolocation) {
        statusText.textContent = "Location services unsupported on this device/browser.";
        indicator.className = "w-2.5 h-2.5 rounded-full bg-rose-500 flex-shrink-0";
        return;
      }

      navigator.geolocation.getCurrentPosition(
        pos => {
          latestGPS = {
            lat: pos.coords.latitude.toFixed(6),
            lng: pos.coords.longitude.toFixed(6),
            accuracy: Math.round(pos.coords.accuracy || 10)
          };
          statusText.textContent = `GPS Locked: ${latestGPS.lat}, ${latestGPS.lng} (±${latestGPS.accuracy}m)`;
          indicator.className = "w-2.5 h-2.5 rounded-full bg-emerald-500 flex-shrink-0";
        },
        err => {
          let errorMsg = "Unable to get device location.";
          if (err.code === 1) errorMsg = "Location permission denied. Please enable GPS permissions in browser settings.";
          else if (err.code === 2) errorMsg = "Position unavailable. Please ensure device Location/GPS is ON.";
          else if (err.code === 3) errorMsg = "GPS request timed out. Please tap Retry.";
          
          statusText.textContent = errorMsg;
          indicator.className = "w-2.5 h-2.5 rounded-full bg-rose-500 flex-shrink-0";
        },
        { enableHighAccuracy: true, timeout: 15000, maximumAge: 0 }
      );
    }

