    function saveAuditProgress(silent = false) {
      if (!activeDepotCode || !isCurrentSlotBooked) {
        if (!silent) alert("Please activate a depot and claim an auditor slot first.");
        return;
      }

      const scrapRadios = document.getElementsByName('scrapInvoiceAvailable');
      let scrapValue = null;
      if (scrapRadios[0]?.checked) scrapValue = "Yes";
      else if (scrapRadios[1]?.checked) scrapValue = "No";

      let audit = auditRecords.find(a => a.id === currentAuditId);
      if (!audit) return;

      audit.scrapInvoiceAvailable = scrapValue;
      audit.scrapInvoicePhoto = scrapValue === 'Yes' ? tempScrapPhotoData : null;
      audit.scrapInvoiceFileName = scrapValue === 'Yes' ? document.getElementById('scrapFileName').textContent : null;
      audit.remarks = document.getElementById('inputRemarks').value;
      audit.workingPapers = [...workingPaperAttachments];

      syncStorage();
      pushAuditToCloud(audit);
      
      const timeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      document.getElementById('mobileStatusIndicator').textContent = `Draft saved at ${timeStr}`;

      if (!silent) {
        alert(`Draft saved for Depot ${activeDepotCode} (Slot ${currentSlotNumber})`);
      }
    }

