    // REVOKE SLOT ENGINE (CLEARS LOCAL CACHE + SIGNALS APPS SCRIPT TO TRASH DRIVE FOLDER & SHEET ROW)
    function leadRevokeSpecificSlot(auditId, depotCode, slotNum, auditorName) {
      if (!confirm(`Revoke Slot ${slotNum} for Depot ${depotCode}?\n\nAuditor: "${auditorName || 'Auditor'}"\n\nThis will permanently delete the folder in Google Drive, remove the row from Google Sheets, and clear the depot from active authorized locations.`)) {
        return;
      }

      const resetRecord = {
        id: auditId,
        depotCode: depotCode,
        slotNumber: slotNum,
        auditorName: "",
        auditorPhone: "",
        status: "Revoked",
        attendance: [],
        workingPapers: [],
        files: {},
        remarks: "",
        scrapInvoiceAvailable: null,
        scrapInvoicePhoto: null
      };

      const idx = auditRecords.findIndex(a => a.id === auditId);
      if (idx >= 0) {
        auditRecords[idx] = resetRecord;
      }

      // Check if this depot has any remaining active slots
      const otherSlotNum = slotNum === 1 ? 2 : 1;
      const otherSlotKey = `AUDIT-${depotCode}-SLOT${otherSlotNum}`;
      const otherAudit = auditRecords.find(a => a.id === otherSlotKey);

      const hasOtherAuditor = otherAudit && otherAudit.auditorPhone && otherAudit.status !== "Scheduled" && otherAudit.status !== "Revoked";

      // If no other auditor is assigned to this depot, remove it from active authorized depots
      if (!hasOtherAuditor) {
        authorizedDepotCodes = authorizedDepotCodes.filter(c => c !== depotCode);
        localStorage.setItem(AUTHORIZED_DEPOTS_KEY, JSON.stringify(authorizedDepotCodes));

        if (activeDepotCode === depotCode) {
          activeDepotCode = authorizedDepotCodes.length > 0 ? authorizedDepotCodes[0] : null;
          if (activeDepotCode) {
            localStorage.setItem(ACTIVE_DEPOT_KEY, activeDepotCode);
          } else {
            localStorage.removeItem(ACTIVE_DEPOT_KEY);
          }
        }
      }

      syncStorage();
      renderAuthorizedDepotsBadges();

      // Post status="Revoked" to delete the folder in Google Drive & delete row in Google Sheet
      pushAuditToCloud(resetRecord);

      if (activeDepotCode) {
        loadDepotSession(activeDepotCode);
      } else {
        resetAuditFields();
      }

      renderLeadTable();
      alert(`Slot ${slotNum} for Depot ${depotCode} has been revoked.\nThe folder in Google Drive and row in Google Sheets have been deleted, and the authorized depot badge has been updated.`);
    }

