      saveAuditProgress(true);
      const audit = auditRecords.find(a => a.id === currentAuditId);
      if (!audit) return;

      if (!audit.attendance || audit.attendance.length === 0) {
        alert("Validation error: At least 1 day of attendance selfie must be logged.");
