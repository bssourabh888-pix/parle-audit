<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Parle Stock Audit - Field Operations & Lead Review Desk</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            parle: {
              50: '#fffbeb',
              100: '#fef3c7',
              500: '#f59e0b',
              600: '#d97706',
              700: '#b45309',
              800: '#92400e',
              900: '#78350f',
              red: '#c22229'
            }
          }
        }
      }
    };
  </script>
  <style>
    .touch-btn:active { transform: scale(0.97); }
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 font-sans min-h-screen flex flex-col antialiased pb-24 sm:pb-8">

  <!-- TOP APP BAR -->
  <header class="sticky top-0 z-40 bg-slate-900 text-white shadow-md border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 py-3 flex flex-wrap justify-between items-center gap-3">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-parle-red to-amber-600 flex items-center justify-center font-black text-white text-xl shadow-md">
          P
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="font-bold text-base sm:text-lg tracking-tight">Parle Stock Audit</span>
            <span id="roleIndicatorBadge" class="text-[10px] bg-amber-500/20 text-amber-300 border border-amber-500/30 px-2 py-0.5 rounded-full font-semibold uppercase tracking-wider">Auditor Portal</span>
          </div>
          <div class="flex items-center gap-2 text-[11px] text-slate-400">
            <span class="flex items-center gap-1">
              <span id="cloudStatusIndicatorDot" class="w-2 h-2 rounded-full bg-emerald-400"></span>
              <span id="cloudStatusIndicatorText">Cloud Live</span>
            </span>
            <span>•</span>
            <span>Max 2 Auditors / Depot</span>
          </div>
        </div>
      </div>

      <div class="flex items-center space-x-2">
        <button onclick="openConnectAdminModal()" class="px-2.5 py-1.5 bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/40 text-xs font-semibold rounded-xl transition flex items-center gap-1.5 touch-btn" title="Contact Lead Desk">
          <i class="ph-bold ph-headset text-sm"></i>
          <span class="hidden sm:inline">Connect with Admin</span>
          <span class="sm:hidden">Help</span>
        </button>

        <div class="bg-slate-800 p-1 rounded-xl flex items-center border border-slate-700 text-xs">
          <button id="navAuditorBtn" onclick="switchToAuditorView()" class="px-3 py-1.5 rounded-lg font-bold transition flex items-center gap-1.5 bg-amber-600 text-white shadow">
            <i class="ph-bold ph-clipboard-text"></i>
            <span class="hidden sm:inline">Auditor</span> Field
          </button>
          <button id="navLeadBtn" onclick="requestLeadDeskAccess()" class="px-3 py-1.5 rounded-lg font-semibold transition flex items-center gap-1.5 text-slate-300 hover:text-white">
            <i class="ph-bold ph-lock-key text-amber-400"></i>
            <span class="hidden sm:inline">Lead</span> Review Desk
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- FLOATING SAVE BAR -->
  <div id="stickySaveBar" class="fixed bottom-0 inset-x-0 z-30 bg-white/95 backdrop-blur-md border-t border-slate-200 px-4 py-2.5 shadow-lg flex items-center justify-between sm:hidden">
    <div class="flex items-center gap-2 text-xs">
      <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
      <span id="mobileStatusIndicator" class="font-semibold text-slate-600">Ready</span>
    </div>
    <div class="flex items-center gap-2">
      <button onclick="openConnectAdminModal()" class="px-3 py-2 bg-amber-50 text-amber-800 font-bold text-xs rounded-xl border border-amber-300 flex items-center gap-1">
        <i class="ph-bold ph-headset"></i> Admin
      </button>
      <button onclick="saveAuditProgress(false)" class="px-4 py-2 bg-slate-900 text-white font-bold text-xs rounded-xl shadow flex items-center gap-1.5 touch-btn">
        <i class="ph-bold ph-floppy-disk text-amber-400"></i>
        <span>Save Draft</span>
      </button>
    </div>
  </div>

  <!-- MAIN APP WORKSPACE -->
  <main class="max-w-7xl mx-auto p-4 sm:p-6 w-full flex-grow space-y-6">

    <!-- VIEW 1: AUDITOR FIELD VIEW -->
    <div id="viewAuditor" class="space-y-5">
      
      <!-- 1. LOCATION SELECTION & USER ID -->
      <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200 space-y-4">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 border-b border-slate-100 pb-3">
          <div>
            <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
              <i class="ph-bold ph-key text-amber-600 text-lg"></i>
              Depot Authorization & User ID
            </h2>
            <p class="text-xs text-slate-500">Enter the Depot User ID provided by the Lead Desk. Maximum 2 auditors allowed per depot.</p>
          </div>
          <div class="flex items-center gap-2">
            <span id="badgeAuditStatus" class="px-3 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-500">
              No Depot Active
            </span>
          </div>
        </div>

        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-2">
          <label class="block text-xs font-bold text-slate-700">Enter Location User ID *</label>
          <div class="flex flex-col sm:flex-row gap-2">
            <input type="text" id="inputDepotUserId" placeholder="e.g. PARLE-3068 or 3068" class="flex-grow bg-white border border-slate-300 rounded-xl px-3 py-2.5 text-xs font-mono font-bold uppercase focus:ring-2 focus:ring-amber-500 focus:outline-none">
            <button onclick="handleAuthorizeDepotUserId()" class="px-5 py-2.5 bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs rounded-xl shadow transition touch-btn flex items-center justify-center gap-1.5">
              <i class="ph-bold ph-sign-in text-base"></i>
              <span>Activate Location</span>
            </button>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1.5">Your Active Authorized Depots (Tap to switch):</label>
          <div id="authorizedDepotsList" class="flex flex-wrap gap-2"></div>
        </div>

        <div id="depotMetaChip" class="p-3.5 bg-slate-50 rounded-xl border border-slate-200 text-xs text-slate-700 flex flex-wrap justify-between items-center gap-2">
          <div class="flex items-center gap-2">
            <i class="ph-fill ph-map-pin text-slate-400 text-lg" id="chipPinIcon"></i>
            <div>
              <p class="font-bold text-slate-900" id="chipDepotName">No depot selected</p>
              <p class="text-[11px] text-slate-500" id="chipDepotState">Activate a location above</p>
            </div>
          </div>
        </div>
      </div>

      <!-- 2. AUDITOR REGISTRATION & STRICT SLOT BOOKING -->
      <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200 space-y-4">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 border-b border-slate-100 pb-3">
          <div>
            <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
              <i class="ph-bold ph-identification-card text-amber-600 text-lg"></i>
              Auditor Slot Booking (Strict 2 Auditors Max)
            </h2>
            <p class="text-xs text-slate-500">Enter complete Name and 10-digit number to claim Slot 1 or Slot 2 for this depot.</p>
          </div>
          <span id="badgeSlotAssigned" class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-slate-100 text-slate-500 font-mono">
            Unregistered
          </span>
        </div>

        <div class="bg-amber-50/60 p-4 rounded-xl border border-amber-200 space-y-3 text-xs">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block font-semibold text-slate-700 mb-1">Auditor Full Name *</label>
              <input type="text" id="inputAuditorName" placeholder="e.g. S. Singhvi" class="w-full bg-white border border-slate-300 rounded-lg p-2.5 font-medium focus:ring-2 focus:ring-amber-500 focus:outline-none">
            </div>
            <div>
              <label class="block font-semibold text-slate-700 mb-1">Auditor Mobile Number (Exact 10 Digits) *</label>
              <input type="tel" id="inputAuditorPhone" maxlength="10" inputmode="numeric" pattern="[0-9]{10}" oninput="this.value = this.value.replace(/\D/g, '').slice(0, 10);" placeholder="10-digit mobile number" class="w-full bg-white border border-slate-300 rounded-lg p-2.5 font-mono font-bold tracking-wider focus:ring-2 focus:ring-amber-500 focus:outline-none">
            </div>
          </div>
          <div class="flex justify-end pt-1">
            <button onclick="bookAuditorSlot()" id="btnBookSlot" class="px-4 py-2 bg-slate-900 hover:bg-black text-white font-bold rounded-xl shadow transition touch-btn flex items-center gap-1.5">
              <i class="ph-bold ph-lock-key text-amber-400"></i>
              <span>Register & Claim Slot</span>
            </button>
          </div>
        </div>
      </div>

      <!-- 3. MULTI-DAY GEO-SELFIE ATTENDANCE -->
      <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200 space-y-4">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 border-b border-slate-100 pb-3">
          <div>
            <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
              <i class="ph-bold ph-camera text-amber-600 text-lg"></i>
              Daily Geo-Selfie Attendance Log
            </h2>
            <p class="text-xs text-slate-500">Check in on arrival. Return later to complete departure check-out on the same date.</p>
          </div>
          <div class="flex items-center gap-2 w-full sm:w-auto">
            <button onclick="saveAuditProgress(false)" class="px-3 py-2 text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition flex items-center gap-1">
              <i class="ph-bold ph-floppy-disk text-amber-600"></i> Save Draft
            </button>
            <button onclick="openAttendanceModal()" id="btnLogAttendanceMaster" class="flex-grow sm:flex-grow-0 px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white text-xs font-bold rounded-xl transition flex items-center justify-center gap-2 shadow touch-btn">
              <i class="ph-bold ph-plus-circle text-base"></i>
              <span id="btnLogAttendanceText">Log Attendance</span>
            </button>
          </div>
        </div>

        <div id="attendanceContainer" class="space-y-3">
          <div class="text-center py-8 text-slate-400 text-xs bg-slate-50 rounded-xl border border-dashed border-slate-200">
            Please register your name and 10-digit mobile number above to unlock attendance.
          </div>
        </div>
      </div>

      <!-- 4. DELIVERABLES & WORKING PAPERS -->
      <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200 space-y-5">
        <div class="border-b border-slate-100 pb-3 flex flex-wrap justify-between items-center gap-2">
          <div>
            <span class="text-[10px] font-bold bg-amber-100 text-amber-800 px-2.5 py-0.5 rounded uppercase tracking-wider">Final Phase</span>
            <h2 class="text-sm font-bold text-slate-900 mt-1">Audit Reports, Count Papers & Deliverables</h2>
            <p class="text-xs text-slate-500">Files sync directly to the Google Drive audit directory.</p>
          </div>
          <button onclick="saveAuditProgress(false)" class="px-3 py-1.5 text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition flex items-center gap-1.5">
            <i class="ph-bold ph-floppy-disk text-amber-600"></i> Save Draft
          </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
          <!-- Working Papers -->
          <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-200 flex flex-col justify-between space-y-3">
            <div>
              <div class="flex items-center justify-between">
                <p class="font-bold text-slate-800 flex items-center gap-1.5 mb-1">
                  <i class="ph-bold ph-files text-rose-600 text-base"></i> Scanned Working Papers *
                </p>
                <span id="wpBadgeCount" class="text-[10px] font-bold bg-rose-100 text-rose-800 px-2 py-0.5 rounded-full">0 Attached</span>
              </div>
              <p class="text-[11px] text-slate-500">Upload signed count sheets or gate passes (PDF).</p>
            </div>
            
            <div class="space-y-2">
              <label class="cursor-pointer flex items-center justify-center gap-2 w-full py-2 bg-rose-50 hover:bg-rose-100 border border-rose-300 text-rose-800 rounded-xl text-xs font-bold transition touch-btn">
                <i class="ph-bold ph-file-plus"></i> Select PDF Files
                <input type="file" id="fileWorkingPapers" multiple accept=".pdf,application/pdf" onchange="handleMultipleWorkingPapers(event)" class="hidden">
              </label>

              <div id="wpFileListContainer" class="space-y-1.5 max-h-36 overflow-y-auto pr-1">
                <p class="text-[10px] text-slate-400 italic">No working papers attached yet</p>
              </div>
            </div>
          </div>

          <!-- Raw ZSD Dump -->
          <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-200 flex flex-col justify-between space-y-3">
            <div>
              <p class="font-bold text-slate-800 flex items-center gap-1.5 mb-1">
                <i class="ph-bold ph-database text-blue-600 text-base"></i> Depot Raw ZSD Dump *
              </p>
              <p class="text-[11px] text-slate-500">Raw SAP/ERP SD stock report export (.xlsx, .csv, .txt).</p>
            </div>
            <div>
              <input type="file" id="fileZsdDump" accept=".xlsx,.xls,.csv,.txt" onchange="handleFilePicked('zsd')" class="w-full text-[11px] text-slate-500 file:mr-2 file:py-1 file:px-2.5 file:rounded-md file:border-0 file:text-xs file:font-bold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 cursor-pointer">
              <div id="statusZsd" class="text-[10px] text-slate-400 mt-1 italic">Not attached</div>
            </div>
          </div>

          <!-- Final Reconciled Excel -->
          <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-200 flex flex-col justify-between space-y-3">
            <div>
              <p class="font-bold text-slate-800 flex items-center gap-1.5 mb-1">
                <i class="ph-bold ph-file-xls text-emerald-600 text-base"></i> Reconciled Excel File *
              </p>
              <p class="text-[11px] text-slate-500">Physical vs Book reconciliation workbook (.xlsx).</p>
            </div>
            <div>
              <input type="file" id="fileReconExcel" accept=".xlsx,.xls" onchange="handleFilePicked('excel')" class="w-full text-[11px] text-slate-500 file:mr-2 file:py-1 file:px-2.5 file:rounded-md file:border-0 file:text-xs file:font-bold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100 cursor-pointer">
              <div id="statusExcel" class="text-[10px] text-slate-400 mt-1 italic">Not attached</div>
            </div>
          </div>
        </div>

        <!-- Scrap Invoice -->
        <div class="p-4 bg-slate-50/80 rounded-xl border border-slate-200 space-y-3 text-xs">
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
            <div>
              <p class="font-bold text-slate-900 flex items-center gap-1.5">
                <i class="ph-bold ph-receipt text-amber-600 text-base"></i>
                Scrap Invoice Verification
              </p>
              <p class="text-[11px] text-slate-500">Confirm if depot issued any damaged/scrap disposal invoices.</p>
            </div>
            <span id="badgeScrapStatus" class="px-2.5 py-0.5 rounded text-[11px] font-bold bg-slate-200 text-slate-600">
              Pending Selection
            </span>
          </div>

          <div>
            <label class="block font-semibold text-slate-700 mb-2">Scrap Invoice Available at Depot? *</label>
            <div class="flex items-center gap-6">
              <label class="flex items-center gap-2 cursor-pointer font-medium text-slate-800">
                <input type="radio" name="scrapInvoiceAvailable" value="Yes" onchange="handleScrapInvoiceToggle(true)" class="w-4 h-4 text-amber-600 focus:ring-amber-500">
                <span>Yes (Invoice Available — Photo Required)</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer font-medium text-slate-800">
                <input type="radio" name="scrapInvoiceAvailable" value="No" onchange="handleScrapInvoiceToggle(false)" class="w-4 h-4 text-amber-600 focus:ring-amber-500">
                <span>No (No Scrap / Not Applicable — Ignore Photo)</span>
              </label>
            </div>
          </div>

          <div id="scrapPhotoSection" class="hidden p-3.5 bg-amber-50/80 border border-amber-200 rounded-xl space-y-3 mt-2">
            <div class="flex items-center justify-between">
              <div>
                <p class="font-bold text-amber-900 text-xs flex items-center gap-1.5">
                  <i class="ph-bold ph-camera text-base"></i> Capture / Upload Scrap Invoice Photo
                </p>
                <p class="text-[11px] text-amber-800/80">Click a clear photo of the stamped scrap bill</p>
              </div>
              <span id="labelScrapPhotoStatus" class="text-[10px] font-bold text-amber-800 bg-amber-200 px-2 py-0.5 rounded">
                Photo Required
              </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="cursor-pointer flex items-center justify-center gap-2 w-full py-2.5 bg-amber-600 hover:bg-amber-700 text-white rounded-xl text-xs font-bold shadow touch-btn">
                  <i class="ph-bold ph-camera"></i> Click Scrap Invoice Photo
                  <input type="file" id="fileScrapInvoice" accept="image/*" capture="environment" onchange="handleScrapPhotoUpload(event)" class="hidden">
                </label>
                <p id="scrapFileName" class="text-[10px] text-slate-500 mt-1 italic truncate">No photo chosen</p>
              </div>

              <div id="scrapPhotoPreviewBox" class="hidden bg-white p-2.5 rounded-xl border border-amber-300 flex items-center gap-3">
                <img id="imgScrapInvoiceThumb" class="w-14 h-14 rounded-lg object-cover border" alt="Scrap Invoice">
                <div class="text-[11px] leading-tight overflow-hidden space-y-0.5">
                  <p class="font-bold text-slate-900">Scrap Invoice Stamped</p>
                  <p class="text-slate-500 text-[10px]" id="scrapInvoiceTimestamp">Recorded</p>
                  <span class="text-emerald-700 font-bold text-[10px]">Photo Attached ✓</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="text-xs">
          <label class="block font-semibold text-slate-700 mb-1">Auditor Remarks / Variance Justification</label>
          <textarea id="inputRemarks" rows="2" oninput="saveAuditProgress(true)" placeholder="Record damaged carton details, cutoff timing, or stock observations..." class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 font-medium focus:ring-2 focus:ring-amber-500 focus:outline-none"></textarea>
        </div>

        <div class="pt-4 border-t border-slate-100 flex flex-col sm:flex-row justify-between items-center gap-3">
          <button onclick="saveAuditProgress(false)" class="w-full sm:w-auto px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition flex items-center justify-center gap-1.5 touch-btn">
            <i class="ph-bold ph-floppy-disk text-amber-600"></i> Save Draft
          </button>
          <button onclick="submitAuditFinal()" id="btnCompleteFinal" class="w-full sm:w-auto px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl shadow-lg transition flex items-center justify-center gap-2 touch-btn">
            <i class="ph-bold ph-paper-plane-tilt text-base"></i> Complete & Sync to Cloud & Drive
          </button>
        </div>
      </div>
    </div>

    <!-- VIEW 2: LEAD AUDITOR REVIEW DESK -->
    <div id="viewLead" class="space-y-6 hidden">
      <div class="bg-slate-900 text-white p-4 rounded-2xl flex flex-wrap justify-between items-center gap-3 shadow-md">
        <div class="flex items-center gap-2.5">
          <div class="p-2 bg-amber-500/20 text-amber-400 rounded-xl">
            <i class="ph-bold ph-shield-check text-xl"></i>
          </div>
          <div>
            <h3 class="font-bold text-sm">Lead Reviewer Session Active</h3>
            <p class="text-xs text-slate-400">Strict 2 Auditors/Depot Enforcement • Read-Only Dossier View & Slot Revocation</p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <button onclick="fetchAuditsFromCloud()" class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-lg flex items-center gap-1.5 shadow touch-btn">
            <i class="ph-bold ph-arrows-clockwise text-sm"></i>
            <span>Refresh Cloud Data</span>
          </button>
          <button onclick="lockLeadDesk()" class="px-3 py-1.5 bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold rounded-lg flex items-center gap-1 shadow">
            <i class="ph-bold ph-lock"></i> Exit & Lock Desk
          </button>
        </div>
      </div>

      <!-- MASTER DEPOT DIRECTORY CARD -->
      <div class="bg-white border-2 border-amber-300 rounded-2xl p-5 shadow-sm space-y-3">
        <div class="flex justify-between items-center">
          <div>
            <h4 class="font-bold text-slate-900 text-sm flex items-center gap-2">
              <i class="ph-bold ph-address-book text-amber-600 text-base"></i>
              Depot User ID Directory (Provide to Field Auditors)
            </h4>
            <p class="text-xs text-slate-500">Share these User IDs with assigned auditors. A maximum of 2 auditors can book slots for each depot.</p>
          </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-2 text-xs pt-1">
          <div id="directoryContainer" class="contents"></div>
        </div>
      </div>

      <!-- GOOGLE SHEETS & DRIVE CLOUD SYNC CARD -->
      <div class="bg-gradient-to-r from-indigo-900 via-indigo-950 to-slate-900 text-white p-5 rounded-2xl border border-indigo-700/50 shadow-lg space-y-4">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
          <div>
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
              <h3 class="text-sm font-bold tracking-tight text-white flex items-center gap-1.5">
                <i class="ph-bold ph-cloud-arrow-up text-indigo-400"></i>
                Google Sheets & Drive Integration
              </h3>
            </div>
