    async function pushAuditToCloud(auditPayload) {
      if (!cloudScriptUrl || !cloudScriptUrl.startsWith("https://script.google.com")) {
        return false;
      }
      try {
        await fetch(cloudScriptUrl, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(auditPayload)
        });
        return true;
      } catch (e) {
        console.error("Cloud push error:", e);
        return false;
      }
    }

    async function fetchAuditsFromCloud() {
      if (!cloudScriptUrl || !cloudScriptUrl.startsWith("https://script.google.com")) {
        return;
      }

      const labelSync = document.getElementById('labelCloudSyncStatus');
      const labelTime = document.getElementById('labelCloudLastSync');
      if (labelSync) labelSync.textContent = "Fetching live audits...";

      try {
        const response = await fetch(cloudScriptUrl);
        const remoteAudits = await response.json();

        if (Array.isArray(remoteAudits)) {
          const remoteMap = new Map();
          remoteAudits.forEach(r => remoteMap.set(r.id, r));

          // Retain or reset local items based on remote status
          auditRecords.forEach((local, idx) => {
            const remote = remoteMap.get(local.id);
            if (!remote || !remote.auditorPhone || remote.status === "Revoked" || remote.status === "Scheduled") {
              auditRecords[idx] = {
                id: local.id,
                depotCode: local.depotCode,
                slotNumber: local.slotNumber || 1,
                auditorName: "",
                auditorPhone: "",
                status: "Scheduled",
                attendance: [],
                workingPapers: [],
                files: {},
                remarks: "",
                scrapInvoiceAvailable: null,
                scrapInvoicePhoto: null
              };
            } else {
              auditRecords[idx] = remote;
            }
          });

          // Ensure any missing depots from authorized lists that have no valid slots are removed
          authorizedDepotCodes = authorizedDepotCodes.filter(code => {
            return auditRecords.some(a => a.depotCode === code && a.auditorPhone && a.status !== "Scheduled" && a.status !== "Revoked");
          });
          localStorage.setItem(AUTHORIZED_DEPOTS_KEY, JSON.stringify(authorizedDepotCodes));

          if (activeDepotCode && !authorizedDepotCodes.includes(activeDepotCode)) {
            activeDepotCode = authorizedDepotCodes.length > 0 ? authorizedDepotCodes[0] : null;
            if (activeDepotCode) localStorage.setItem(ACTIVE_DEPOT_KEY, activeDepotCode);
            else localStorage.removeItem(ACTIVE_DEPOT_KEY);
          }

          syncStorage();
          renderAuthorizedDepotsBadges();

          if (isLeadAuthenticated) {
            renderLeadTable();
          }
          if (activeDepotCode) {
            loadDepotSession(activeDepotCode);
          } else {
            resetAuditFields();
          }

          if (labelSync) labelSync.textContent = `Connected (${remoteAudits.length} Audits Synced)`;
          if (labelTime) labelTime.textContent = `Last checked: ${new Date().toLocaleTimeString()}`;
        }
      } catch (err) {
        console.error("Fetch error:", err);
        if (labelSync) labelSync.textContent = "Connected & Ready";
      }
    }

