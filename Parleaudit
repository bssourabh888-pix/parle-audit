    function handleFilePicked(type) {
      if (!isCurrentSlotBooked) {
        alert("Please register your Name and 10-digit number above to claim a slot before attaching files.");
        return;
      }

      let audit = auditRecords.find(a => a.id === currentAuditId);
      if (!audit) return;
      if (!audit.files) audit.files = {};

      if (type === 'zsd') {
        const file = document.getElementById('fileZsdDump').files[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = function(e) {
            audit.files.zsdDump = file.name;
