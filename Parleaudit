      { code: "3116", userId: "PARLE-3116", name: "Tucarama S Lolienkar", location: "Goa", state: "Goa" }
    ];

    const DATA_KEY = 'parle_audit_records_master_v21';
    const AUTHORIZED_DEPOTS_KEY = 'parle_authorized_depots_v21';
    const ACTIVE_DEPOT_KEY = 'parle_active_depot_code_v21';
    const ADMIN_SETTINGS_KEY = 'parle_admin_contact_settings_v21';
    const PIN_KEY = 'parle_lead_reviewer_pin_v21';
    const CLOUD_URL_KEY = 'parle_cloud_script_url_v21';

    const DEFAULT_CLOUD_URL = 'https://script.google.com/macros/s/AKfycbwT2kbKUL2_PaDkug-lTWiQ8GRymxSJ3HQVI-hYekrUWbblY9ubiRSfMnFKcFdvMcxtxA/exec';

    let auditRecords = JSON.parse(localStorage.getItem(DATA_KEY) || '[]');
    let authorizedDepotCodes = JSON.parse(localStorage.getItem(AUTHORIZED_DEPOTS_KEY) || '[]');
    let activeDepotCode = localStorage.getItem(ACTIVE_DEPOT_KEY) || null;
    let cloudScriptUrl = localStorage.getItem(CLOUD_URL_KEY) || DEFAULT_CLOUD_URL;
    let isLeadAuthenticated = false;

    let leadReviewerPin = localStorage.getItem(PIN_KEY) || '1234';

    let adminSettings = JSON.parse(localStorage.getItem(ADMIN_SETTINGS_KEY) || JSON.stringify({
      name: "Lead CA / Central Audit Desk",
      phone: "+91 98765 43210"
    }));

    let currentAuditId = null;
    let currentSlotNumber = 1;
    let isCurrentSlotBooked = false;
    let latestGPS = null;
    let tempAttendanceEntry = { checkin: null, checkout: null };
    let tempScrapPhotoData = null;
    let workingPaperAttachments = [];
    let editingAttendanceDayIndex = -1;

    window.addEventListener('DOMContentLoaded', () => {
      renderDirectoryGrid();
      loadAdminSettingsInputs();
      initCloudSyncUI();
      document.getElementById('modalDayDate').valueAsDate = new Date();
      acquireLiveGPS();

      if (authorizedDepotCodes.length > 0) {
        if (!activeDepotCode || !authorizedDepotCodes.includes(activeDepotCode)) {
          activeDepotCode = authorizedDepotCodes[0];
          localStorage.setItem(ACTIVE_DEPOT_KEY, activeDepotCode);
        }
        renderAuthorizedDepotsBadges();
        loadDepotSession(activeDepotCode);
      } else {
        activeDepotCode = null;
        localStorage.removeItem(ACTIVE_DEPOT_KEY);
        renderAuthorizedDepotsBadges();
        resetAuditFields();
      }

      switchToAuditorView();
      fetchAuditsFromCloud();
    });

    // LOCATION AUTHORIZATION
    function handleAuthorizeDepotUserId() {
      const input = document.getElementById('inputDepotUserId');
      const enteredId = input.value.trim().toUpperCase();

      if (!enteredId) {
        alert("Please enter a valid Location User ID (e.g. PARLE-3068 or 3068).");
        return;
      }

      const matchedDepot = MASTER_DEPOTS.find(d => 
        d.userId.toUpperCase() === enteredId || 
        d.code === enteredId || 
        `PARLE-${d.code}` === enteredId
      );

      if (!matchedDepot) {
        alert(`Unrecognized User ID: "${enteredId}". Please request authorization from the Lead Review Desk.`);
        return;
      }

      if (!authorizedDepotCodes.includes(matchedDepot.code)) {
        authorizedDepotCodes.push(matchedDepot.code);
        localStorage.setItem(AUTHORIZED_DEPOTS_KEY, JSON.stringify(authorizedDepotCodes));
      }

      selectActiveDepot(matchedDepot.code);
      input.value = '';
    }

    function selectActiveDepot(code) {
      if (activeDepotCode && isCurrentSlotBooked) {
        saveAuditProgress(true);
      }

      activeDepotCode = code;
      localStorage.setItem(ACTIVE_DEPOT_KEY, activeDepotCode);
      renderAuthorizedDepotsBadges();
      loadDepotSession(code);
    }

    function renderAuthorizedDepotsBadges() {
      const container = document.getElementById('authorizedDepotsList');
      container.innerHTML = '';

      if (authorizedDepotCodes.length === 0) {
        container.innerHTML = `<span class="text-xs text-slate-400 italic">No depots authorized yet. Enter User ID above.</span>`;
        return;
      }

      authorizedDepotCodes.forEach(code => {
        const depot = MASTER_DEPOTS.find(d => d.code === code);
        const isActive = (code === activeDepotCode);

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.onclick = () => selectActiveDepot(code);
        btn.className = isActive ? 
          "px-3 py-1.5 rounded-xl font-bold text-xs bg-amber-600 text-white shadow flex items-center gap-1.5 border border-amber-700" :
          "px-3 py-1.5 rounded-xl font-medium text-xs bg-white text-slate-700 hover:bg-slate-100 flex items-center gap-1.5 border border-slate-200 transition";

        btn.innerHTML = `
          <i class="ph-bold ${isActive ? 'ph-check-circle text-white' : 'ph-map-pin text-slate-400'}"></i>
          <span>${code} - ${depot ? depot.location : 'Depot'}</span>
          <span class="text-[10px] ${isActive ? 'text-amber-200' : 'text-slate-400'} font-mono">(${depot?.userId || code})</span>
        `;
        container.appendChild(btn);
      });
    }

    // STRICT 2-AUDITOR ENGINE
    function loadDepotSession(code) {
      const depot = MASTER_DEPOTS.find(d => d.code === code);
      if (!depot) return;

      document.getElementById('chipDepotName').textContent = `${depot.code} - ${depot.name} (${depot.userId})`;
      document.getElementById('chipDepotState').textContent = `${depot.location}, ${depot.state}`;

      const pinIcon = document.getElementById('chipPinIcon');
      pinIcon.className = "ph-fill ph-map-pin text-parle-red text-lg";

      const slot1Key = `AUDIT-${code}-SLOT1`;
      const slot2Key = `AUDIT-${code}-SLOT2`;
      const recordSlot1 = auditRecords.find(a => a.id === slot1Key);
      const recordSlot2 = auditRecords.find(a => a.id === slot2Key);

      const currentPhone = (document.getElementById('inputAuditorPhone')?.value || '').replace(/\D/g, '').slice(0, 10);

      if (currentPhone && recordSlot1 && recordSlot1.auditorPhone === currentPhone) {
        setSessionActiveSlot(recordSlot1, 1);
        return;
      }
      if (currentPhone && recordSlot2 && recordSlot2.auditorPhone === currentPhone) {
        setSessionActiveSlot(recordSlot2, 2);
        return;
      }

      if (!recordSlot1 || !recordSlot1.auditorPhone) {
        setSessionUnregisteredSlot(code, 1);
        return;
      }

      if (!recordSlot2 || !recordSlot2.auditorPhone) {
        setSessionUnregisteredSlot(code, 2);
        return;
      }

      setSessionDepotFull(code, recordSlot1, recordSlot2);
    }

    function setSessionActiveSlot(auditRecord, slotNumber) {
      currentAuditId = auditRecord.id;
      currentSlotNumber = slotNumber;
      isCurrentSlotBooked = true;

      loadAuditIntoForm(auditRecord.id);

      const slotBadge = document.getElementById('badgeSlotAssigned');
      slotBadge.textContent = `Claimed: Slot ${slotNumber} (Max 2)`;
      slotBadge.className = "px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 font-mono border border-emerald-300";

      document.getElementById('btnBookSlot').classList.add('hidden');
      document.getElementById('inputAuditorName').disabled = true;
      document.getElementById('inputAuditorPhone').disabled = true;
    }

    function setSessionUnregisteredSlot(code, slotNumber) {
      currentAuditId = `AUDIT-${code}-SLOT${slotNumber}`;
      currentSlotNumber = slotNumber;
      isCurrentSlotBooked = false;

      resetAuditFields();

      const slotBadge = document.getElementById('badgeSlotAssigned');
      slotBadge.textContent = `Available: Slot ${slotNumber} of 2`;
      slotBadge.className = "px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 font-mono border border-amber-300";

      document.getElementById('btnBookSlot').classList.remove('hidden');
      document.getElementById('btnBookSlot').innerHTML = `<i class="ph-bold ph-lock-key text-amber-400"></i><span>Register for Slot ${slotNumber}</span>`;
      document.getElementById('inputAuditorName').disabled = false;
      document.getElementById('inputAuditorPhone').disabled = false;

      document.getElementById('badgeAuditStatus').textContent = "Status: Unregistered Slot";
      document.getElementById('badgeAuditStatus').className = "px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800";
    }

    function setSessionDepotFull(code, s1, s2) {
      currentAuditId = null;
      isCurrentSlotBooked = false;
      resetAuditFields();

      const slotBadge = document.getElementById('badgeSlotAssigned');
      slotBadge.textContent = "Depot Full (2/2 Slots Claimed)";
      slotBadge.className = "px-2.5 py-1 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800 font-mono border border-rose-300";

      document.getElementById('btnBookSlot').classList.add('hidden');
      document.getElementById('inputAuditorName').disabled = true;
      document.getElementById('inputAuditorPhone').disabled = true;

      document.getElementById('badgeAuditStatus').textContent = "Status: Slot Limit Reached (Max 2)";
      document.getElementById('badgeAuditStatus').className = "px-3 py-1 rounded-full text-xs font-bold bg-rose-100 text-rose-800";

      document.getElementById('attendanceContainer').innerHTML = `
        <div class="p-4 bg-rose-50 border border-rose-200 rounded-xl text-center space-y-2">
          <p class="font-bold text-rose-800 text-xs">Maximum 2 Auditors Already Registered for Depot ${code}</p>
          <p class="text-[11px] text-slate-600">Slot 1: ${s1.auditorName} (${s1.auditorPhone})<br>Slot 2: ${s2.auditorName} (${s2.auditorPhone})</p>
          <p class="text-[10px] text-slate-400">If you are one of the two auditors above, enter your exact 10-digit number. Otherwise, request a slot reset from the Lead Desk.</p>
        </div>
      `;
    }

    function bookAuditorSlot() {
      if (!activeDepotCode) {
        alert("Please activate a Depot User ID first.");
        return;
      }

      const name = document.getElementById('inputAuditorName').value.trim();
      const phone = (document.getElementById('inputAuditorPhone').value || '').replace(/\D/g, '').slice(0, 10);

      if (!name) {
        alert("Validation error: Please enter Auditor Full Name.");
        document.getElementById('inputAuditorName').focus();
        return;
      }

      if (!phone || phone.length !== 10) {
        alert("Validation error: Please enter an exact 10-digit numerical mobile number.");
        document.getElementById('inputAuditorPhone').focus();
        return;
      }

      const slotKey = `AUDIT-${activeDepotCode}-SLOT${currentSlotNumber}`;
      let audit = auditRecords.find(a => a.id === slotKey);

      if (!audit) {
        audit = {
          id: slotKey,
          depotCode: activeDepotCode,
          slotNumber: currentSlotNumber,
          auditorName: name,
          auditorPhone: phone,
          scrapInvoiceAvailable: null,
          scrapInvoicePhoto: null,
          scrapInvoiceFileName: null,
          remarks: "",
          status: "In Progress",
          attendance: [],
          workingPapers: [],
          files: {}
        };
        auditRecords.push(audit);
      } else {
        audit.auditorName = name;
        audit.auditorPhone = phone;
        audit.status = "In Progress";
      }

      syncStorage();
      pushAuditToCloud(audit);

      setSessionActiveSlot(audit, currentSlotNumber);
      alert(`Success! Slot ${currentSlotNumber} claimed for Depot ${activeDepotCode}.\nAttendance and deliverables are now unlocked.`);
    }

    function renderDirectoryGrid() {
      const container = document.getElementById('directoryContainer');
      container.innerHTML = '';

      MASTER_DEPOTS.forEach(d => {
        const card = document.createElement('div');
        card.className = "p-2.5 bg-slate-50 border border-slate-200 rounded-xl flex flex-col justify-between";
        card.innerHTML = `
          <div>
            <p class="font-bold text-slate-800 text-[11px]">${d.location}</p>
            <p class="text-[10px] text-slate-500 truncate" title="${d.name}">${d.name}</p>
          </div>
          <div class="mt-2 pt-1.5 border-t border-slate-200 flex items-center justify-between">
            <span class="font-mono font-bold text-amber-700 text-[11px]">${d.userId}</span>
            <button onclick="copyText('${d.userId}')" title="Copy User ID" class="text-slate-400 hover:text-slate-700">
              <i class="ph-bold ph-copy text-xs"></i>
            </button>
          </div>
        `;
        container.appendChild(card);
      });
    }

    function copyText(txt) {
      navigator.clipboard?.writeText(txt).then(() => alert(`Copied User ID: ${txt}`));
    }

    // CLOUD SYNC & DRIVE CONFIG
