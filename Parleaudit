            document.getElementById('statusZsd').textContent = `Attached: ${file.name} ✓`;
            saveAuditProgress(true);
          };
          reader.readAsDataURL(file);
        }
      }

      if (type === 'excel') {
        const file = document.getElementById('fileReconExcel').files[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = function(e) {
            audit.files.reconciledExcel = file.name;
            audit.files.excelDataBase64 = e.target.result;
            document.getElementById('statusExcel').textContent = `Attached: ${file.name} ✓`;
            saveAuditProgress(true);
          };
          reader.readAsDataURL(file);
        }
